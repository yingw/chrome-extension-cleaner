{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chrome Extension Cleaner",
  "version": "1.0.0",
  "identifier": "com.yinguowei.chrome-ext-cleaner",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Chrome Extension Cleaner",
        "width": 1200,
        "height": 860,
        "minWidth": 1000,
        "maxWidth": 1200,
        "minHeight": 640,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 25 },
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
